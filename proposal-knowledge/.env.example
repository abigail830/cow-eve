DATABASE_URL=sqlite:///./proposal_knowledge.db

# Ops-only: protects POST /internal/v1/api-keys (mint/revoke keys). Not used by Eve MCP.
PROPOSAL_KNOWLEDGE_ADMIN_KEY=

# Optional bootstrap ONLY (local/single-tenant). Production: use pk_live_… rows in pk_api_key.
PROPOSAL_KNOWLEDGE_MCP_API_KEY=
PROPOSAL_KNOWLEDGE_ALLOWED_BUS=*

API_KEY_HASH_PEPPER=change-me-in-production

# Vercel Blob (optional). If AVATAR_PUBLIC_BASE_URL is empty, base URL is derived as:
#   https://{store_id}.{public|private}.blob.vercel-storage.com
BLOB_STORE_ID=
BLOB_ACCESS=private
BLOB_READ_WRITE_TOKEN=
AVATAR_PUBLIC_BASE_URL=
