{
  "compilerOptions": {
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["node", "eve/workflow-modules"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "#platform/*": ["./platform/*"]
    }
  },
  "include": ["agents/**/*.ts", "platform/**/*.ts", "extensions/**/*.ts", "evals/**/*.ts"]
}
