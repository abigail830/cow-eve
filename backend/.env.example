# Local / Vercel env for cow-eve backend
JWT_SECRET=cow-eve-dev-jwt-secret-change-me
# Comma-separated extras; localhost + https://fde-desk.vercel.app are always allowed
FRONTEND_ORIGIN=http://127.0.0.1:5273,http://localhost:5273,https://fde-desk.vercel.app
# Model API is configured in the UI: Settings → Model
# Platform utility LLM (attachment gist, etc.) — direct Chat Completions, no thinking on DashScope
# UTILITY_MODEL_API_KEY=
# UTILITY_MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# UTILITY_MODEL_DEPLOYMENT=qwen3.7-flash
# PLATFORM_DATA_DIR=
# Local chat artifact blobs (default: backend/platform/data/chat-artifacts)
# Vercel Blob (optional locally; required on Vercel for artifact publish/download)
# On Vercel: prefer Storage → Blob integration (OIDC + BLOB_STORE_ID). If you also
# set BLOB_READ_WRITE_TOKEN manually, do NOT wrap the value in quotes.
# BLOB_READ_WRITE_TOKEN=
# BLOB_STORE_ID=
# BLOB_ACCESS=private

# E2B sandbox (artifacts__studio subagent). The template is an existing image — sessions start
# from it and do not rebuild it. Official adapter: @e2b/eve-sandbox.
# E2B_API_KEY=
# E2B_CONTENT_STUDIO_TEMPLATE=okf-content-studio:1.15
# E2B_AUTO_PAUSE=false — default; running sandbox times out to kill (not pause) if turn-end pause fails
# SANDBOX_CLEANUP_IDLE_MS=86400000 — kill sandboxes for chats idle 1d+ (omni schedule sandbox-cleanup)
# SANDBOX_CLEANUP_AGENT_IDS=omni

# Omni MCP connections (optional — omit keys to disable a provider)
# HYBRID_SEARCH_MCP_URL=https://cow-platform-ii.vercel.app/api/mcp/hybrid-search
# HYBRID_SEARCH_API_KEY=
# ZHIPU_WEB_SEARCH_MCP_URL=https://open.bigmodel.cn/api/mcp/web_search_prime/mcp
# ZHIPU_API_KEY=
# Per-user OAuth MCP integrations (Notion hosted MCP) - agent-platform-local
# NOTION_MCP_CLIENT_ID=
# NOTION_MCP_CLIENT_SECRET=
# NOTION_MCP_REDIRECT_URI=http://127.0.0.1:8000/api/v1/integrations/notion/callback

# Attachment parse — service (local) OR gha (GitHub Actions)
# auto = gha when GITHUB_TOKEN + GITHUB_REPO set, else service
# PARSE_PIPELINE_DISPATCH=service
# PARSE_PIPELINE_SERVICE_URL=http://127.0.0.1:8091
# Must match parse-pipeline/.env PARSE_PIPELINE_API_KEYS (caller_id:secret)
# PARSE_PIPELINE_SERVICE_API_KEY=psk_...
# PARSE_PIPELINE_SERVICE_CALLER_ID=cow-eve
# Public Omni URL (GHA runners + webhooks must reach this; not 127.0.0.1 in prod)
# PARSE_PIPELINE_PUBLIC_BASE_URL=https://your-deployment.example
# PARSE_PIPELINE_WEBHOOK_PATH=/internal/parse/v1/webhook
# GHA (requires .github/workflows/parse-pipeline-run-job.yml on default branch)
# PARSE_PIPELINE_DISPATCH=gha
# GITHUB_TOKEN=ghp_...
# GITHUB_REPO=abigail830/cow-eve
# GITHUB_WORKFLOW_FILE=parse-pipeline-run-job.yml
# GITHUB_REF=main
# Repo secrets for workflow: DOCUMENT_MIND_ACCESS_KEY_ID, DOCUMENT_MIND_ACCESS_KEY_SECRET, DASHSCOPE_API_KEY

# Neon Postgres (chat history index + event projection)
DATABASE_URL=postgres://USER:PASSWORD@HOST/neondb?sslmode=require

# Upstash Redis / Vercel KV (Eve cross-session memory via redisMemory)
# Prefer REST pair — Redis.fromEnv also accepts KV_REST_API_* :
UPSTASH_REDIS_REST_URL=https://YOUR_DB.upstash.io
UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
