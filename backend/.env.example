# Local / Vercel env for cow-eve backend
JWT_SECRET=cow-eve-dev-jwt-secret-change-me
# Comma-separated extras; localhost + https://fde-desk.vercel.app are always allowed
FRONTEND_ORIGIN=http://127.0.0.1:5273,http://localhost:5273,https://fde-desk.vercel.app
# Model API is configured in the UI: Settings → Model
# Platform utility LLM (attachment gist, async chat titles, etc.) — direct Chat Completions, no thinking on DashScope
# UTILITY_MODEL_API_KEY=
# UTILITY_MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# UTILITY_MODEL_DEPLOYMENT=qwen3.7-flash
# After this many completed user turns, run one-shot LLM sidebar title (default 2). Until then / on LLM failure, title stays titleFromMessage (first-line truncate).
# TITLE_LLM_AFTER_USER_TURN=2
# PLATFORM_DATA_DIR=
# Local chat artifact blobs (default: backend/platform/data/chat-artifacts)
# Vercel Blob (required on Vercel for chat attachments + artifacts; enables browser direct upload up to 50 MB/file)
# On Vercel: prefer Storage → Blob integration (OIDC + BLOB_STORE_ID). If you also
# set BLOB_READ_WRITE_TOKEN manually, do NOT wrap the value in quotes.
# BLOB_READ_WRITE_TOKEN=
# BLOB_STORE_ID=
# BLOB_ACCESS=private
# Audio transcript (ASR): parts in Blob; mint returns public blob URLs or presigned GET URLs (private store). Required locally: BLOB_READ_WRITE_TOKEN.

# E2B sandbox (artifacts__studio subagent). The template is an existing image — sessions start
# from it and do not rebuild it. Official adapter: @e2b/eve-sandbox.
# E2B_API_KEY=
# E2B_CONTENT_STUDIO_TEMPLATE=okf-content-studio:1.15
# Global npm root in the Content Studio image (omni sets NODE_PATH for Node create scripts)
# CONTENT_STUDIO_NODE_PATH=/usr/local/lib/node_modules
# E2B_AUTO_PAUSE=false — default; running sandbox times out to kill (not pause) if turn-end pause fails
# SANDBOX_CLEANUP_IDLE_MS=86400000 — kill sandboxes for chats idle 1d+ (omni schedule sandbox-cleanup)
# SANDBOX_CLEANUP_AGENT_IDS=omni

# Omni MCP connections (optional — omit keys to disable a provider)
# Hybrid Search (OpenKMS) — same host for MCP + KB list; Bearer okf_… for both.
# MCP (agent):     {base}/api/mcp/hybrid-search
# KB list (UI):    {base}/api/knowledge/knowledge-bases  (see agent-platform kb_client.py)
# HYBRID_SEARCH_MCP_URL=https://cow-platform-ii.vercel.app/api/mcp/hybrid-search
# HYBRID_SEARCH_API_KEY=   # optional server fallback; users normally set okf_ in Integrations
# HYBRID_SEARCH_API_BASE= # optional; defaults to MCP URL without /api/mcp/hybrid-search
# Proposal Knowledge (separate Vercel project; MCP Streamable HTTP — include /mcp suffix)
# Local dev (must match running proposal-knowledge on 8093 for recall_catalog):
# PROPOSAL_CATALOG_MCP_URL=http://127.0.0.1:8093/api/mcp/catalog/mcp
# PROPOSAL_CV_MCP_URL=http://127.0.0.1:8093/api/mcp/cv/mcp
# PROPOSAL_CATALOG_MCP_URL=https://your-pk.vercel.app/api/mcp/catalog/mcp
# PROPOSAL_CV_MCP_URL=https://your-pk.vercel.app/api/mcp/cv/mcp
# PROPOSAL_KNOWLEDGE_API_KEY=pk_live_…  # optional server fallback; users normally set in Integrations
# ZHIPU_WEB_SEARCH_MCP_URL=https://open.bigmodel.cn/api/mcp/web_search_prime/mcp
# ZHIPU_API_KEY= — Coding Plan key only (no "Bearer " prefix); dev fallback when user has not set Integrations
# OAuth MCP integrations (PKCE) — redirect URI must hit platform backend:
#   {PARSE_PIPELINE_PUBLIC_BASE_URL or http://127.0.0.1:2000}/api/integrations/notion/callback
# INTEGRATION_SUCCESS_REDIRECT=http://127.0.0.1:5273
# INTEGRATION_OAUTH_STATE_SECRET=  # optional; defaults to JWT_SECRET
# NOTION_MCP_CLIENT_ID=
# NOTION_MCP_CLIENT_SECRET=
# NOTION_MCP_REDIRECT_URI=http://127.0.0.1:2000/api/integrations/notion/callback
# NOTION_MCP_URL=https://mcp.notion.com/mcp
# HUBSPOT_MCP_CLIENT_ID=
# HUBSPOT_MCP_CLIENT_SECRET=
# HUBSPOT_MCP_REDIRECT_URI=http://127.0.0.1:2000/api/integrations/hubspot/callback
# HUBSPOT_MCP_URL=https://mcp.hubspot.com/mcp

# Attachment parse — service (local) OR gha (GitHub Actions)
# auto = gha when GITHUB_TOKEN + GITHUB_REPO set, else service
# Local dev: prefer service + parse-pipeline on :8091 (see scripts/start.sh)
PARSE_PIPELINE_DISPATCH=service
PARSE_PIPELINE_SERVICE_URL=http://127.0.0.1:8091
PARSE_PIPELINE_PUBLIC_BASE_URL=http://127.0.0.1:2000
# Must match parse-pipeline/.env PARSE_PIPELINE_API_KEYS (caller_id:secret)
# PARSE_PIPELINE_SERVICE_API_KEY=psk_...
# PARSE_PIPELINE_SERVICE_CALLER_ID=cow-eve
# Public Omni *backend* URL (same host that serves /api/* and /internal/parse/v1/*).
# GHA runners + webhooks must reach this — not a frontend-only SPA host, not 127.0.0.1 in prod.
# After deploy, verify: curl -s -o /dev/null -w "%{http_code}" "$BASE/internal/parse/v1/run/test" → 401 (not 404).
# PARSE_PIPELINE_PUBLIC_BASE_URL=https://your-backend.vercel.app
# PARSE_PIPELINE_WEBHOOK_PATH=/internal/parse/v1/webhook
# GHA (requires .github/workflows/parse-pipeline-run-job.yml on default branch)
# PARSE_PIPELINE_DISPATCH=gha
# GITHUB_TOKEN=ghp_...
# GITHUB_REPO=abigail830/cow-eve
# GITHUB_WORKFLOW_FILE=parse-pipeline-run-job.yml
# GITHUB_REF=main
# Repo secrets for workflow: DOCUMENT_MIND_ACCESS_KEY_ID, DOCUMENT_MIND_ACCESS_KEY_SECRET, DASHSCOPE_API_KEY

# Neon Postgres (chat history index + event projection)
# Quote the URL if it contains & (required for scripts that `source .env`).
DATABASE_URL="postgres://USER:PASSWORD@HOST/neondb?sslmode=require"

# Upstash Redis / Vercel KV (Eve cross-session memory via redisMemory)
# Prefer REST pair — Redis.fromEnv also accepts KV_REST_API_* :
UPSTASH_REDIS_REST_URL=https://YOUR_DB.upstash.io
UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
