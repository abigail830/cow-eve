{
  "name": "cow-eve-backend",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "imports": {
    "#platform/*": "./platform/*"
  },
  "scripts": {
    "build:extensions": "npm run build --prefix extensions/knowledge && npm run build --prefix extensions/schedules && npm run build --prefix extensions/projects",
    "register:notion-mcp": "tsx scripts/register-notion-mcp-oauth.ts",
    "sync:integrations": "tsx scripts/sync-wired-integrations-manifest.ts",
    "build": "npm run db:migrate && npm run sync:integrations && npm run build:extensions && eve build && node scripts/inject-vercel-research-patch-build.mjs && npm run patch:research-workflow-id",
    "patch:research-workflow-id": "node scripts/patch-eve-research-workflow-id.mjs",
    "deploy": "eve deploy",
    "dev": "eve dev --agent omni --no-ui --port 2000",
    "dev:omni": "cd agents/omni && EVE_INTERNAL_AGENT_WORKSPACE_MEMBER=1 ../../node_modules/.bin/eve dev --no-ui --port 2000",
    "dev:research": "bash scripts/dev-research.sh",
    "dev:nova-auditor": "cd agents/nova-auditor && EVE_INTERNAL_AGENT_WORKSPACE_MEMBER=1 ../../node_modules/.bin/eve dev --no-ui --port 2003",
    "dev:x-proposal": "cd agents/x-proposal && EVE_INTERNAL_AGENT_WORKSPACE_MEMBER=1 ../../node_modules/.bin/eve dev --no-ui --port 2004",
    "dev:ui": "eve dev --agent omni",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx platform/infrastructure/persistence/database/migrate.ts",
    "test": "tsx --test platform/application/**/*.test.ts platform/domain/**/*.test.ts platform/infrastructure/config/**/*.test.ts platform/infrastructure/parse-pipeline/**/*.test.ts platform/infrastructure/agents/**/*.test.ts platform/interfaces/http/helpers/**/*.test.ts platform/interfaces/eve/**/*.test.ts agents/omni/agent/lib/**/*.test.ts agents/nova-auditor/agent/lib/**/*.test.ts agents/x-proposal/agent/lib/**/*.test.ts extensions/projects/extension/lib/**/*.test.ts ../frontend/src/lib/**/*.test.ts",
    "test:schedule": "tsx scripts/test-schedule-smoke.ts",
    "test:research-mcp": "tsx scripts/research-mcp-smoke.ts",
    "test:compile": "npm run typecheck && npm run build",
    "eval": "eve eval",
    "start": "eve start",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@ai-sdk/mcp": "^2.0.66",
    "@ai-sdk/openai-compatible": "^3.0.53",
    "@fde/knowledge": "file:./extensions/knowledge",
    "@fde/projects": "file:./extensions/projects",
    "@fde/schedules": "file:./extensions/schedules",
    "@neondatabase/serverless": "^1.1.0",
    "@upstash/agentkit-eve": "^0.15.1",
    "@upstash/redis": "^1.38.4",
    "@vercel/blob": "^2.8.0",
    "@vercel/connect": "2.2.0",
    "ai": "^7.0.105",
    "bcryptjs": "^3.0.2",
    "drizzle-orm": "^0.45.2",
    "e2b": "^2.51.0",
    "eve": "^0.74.0",
    "jose": "^6.0.11",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "24.x",
    "drizzle-kit": "^0.31.10",
    "just-bash": "^3.6.0",
    "microsandbox": "^0.5.10",
    "tsx": "^4.23.13",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": "24.x"
  }
}
