# Platform HTTP (login, chats, settings) — omni /api/* on the backend host
VITE_API_URL=http://127.0.0.1:2000
# Eve session hosts (local: separate ports; production: /eve/<agent>)
VITE_AGENT_URLS=omni=http://127.0.0.1:2000,research=http://127.0.0.1:2002,nova-auditor=http://127.0.0.1:2003,x-proposal=http://127.0.0.1:2004

# Production example (frontend Vercel project, e.g. fde-desk):
# VITE_API_URL=https://<backend-host>          # platform /api/* (NOT .../eve/omni)
# VITE_AGENT_URLS=omni=https://<backend-host>/eve/omni,research=https://<backend-host>/eve/research,nova-auditor=https://<backend-host>/eve/nova-auditor
# If VITE_AGENT_URLS is omitted, the app uses VITE_API_URL + /eve/<agentId> (works when all agents deploy on one backend host).
