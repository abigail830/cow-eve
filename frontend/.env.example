# Platform HTTP (login, chats, settings) — omni /api/* on the backend host
VITE_API_URL=http://127.0.0.1:2000
# Eve session hosts (local: separate ports; production: /eve/<agent>)
VITE_AGENT_URLS=omni=http://127.0.0.1:2000

# Production example (frontend project on Vercel):
# VITE_API_URL=https://cow-eve.vercel.app
# VITE_AGENT_URLS=omni=https://cow-eve.vercel.app/eve/omni
